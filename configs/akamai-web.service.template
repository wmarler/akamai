# Install as /etc/systemd/system/akamai-web.service
# Rendered from configs/akamai-web.service.template by configs/generate_configs.sh.

[Unit]
Description=web/server.py (self-service Flatcar guest provisioning)
Documentation=file://@@AKAMAI_DIR@@/README.md
After=network-online.target libvirtd.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
WorkingDirectory=@@AKAMAI_DIR@@
ExecStart=/usr/bin/python3 @@AKAMAI_DIR@@/web/server.py
Restart=on-failure
RestartSec=3

# The service escalates through sudo for the two provisioning scripts, so
# NoNewPrivileges / capability bounding / ProtectSystem cannot be used here:
# they would apply to the root-run scripts as well. What is left is still
# worthwhile.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
