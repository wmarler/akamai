# Copy this file to configs/actual/secrets (git-ignored) and fill it in.
#
# Everything deployment-specific lives here: credentials, the DNS zone, the
# LAN layout, and host paths. The file is plain KEY="value" lines; it is
# sourced by bash (lib/common.sh) and parsed by Python (web/server.py), so
# keep it to simple assignments -- no command substitution or logic.
#
# Ownership: osmc:<SERVICE_USER> mode 0640. The web service reads the
# non-secret keys it needs; the Cloudflare token is only used by the
# root-run provisioning scripts.

###############################################################################
# Cloudflare
###############################################################################

# Either put the API token here ...
CLOUDFLARE_API_TOKEN=""
# ... or point at a file that contains it. Both a bare token and certbot's
# cloudflare.ini format ("dns_cloudflare_api_token = ...") are accepted.
CLOUDFLARE_API_TOKEN_FILE="/root/cloudflare_token"

# Zone ID of BASE_DOMAIN. Optional: looked up (and cached under state/) when
# empty, but setting it saves an API round-trip and a Zone:Read permission.
CLOUDFLARE_ZONE_ID=""

# Create the CNAME as a Cloudflare-proxied ("orange cloud") record. This must
# match the apex record it aliases: if the apex is proxied, the alias must be
# too, otherwise Cloudflare's edge has no route for the new hostname.
CLOUDFLARE_PROXIED="true"

###############################################################################
# Naming
###############################################################################

# Zone the instances live under.
BASE_DOMAIN="example.com"

# Hostname nginx uses to reach web/server.py (form + API).
PORTAL_HOST="akamai.example.com"

# Prefix on every guest hostname. "bob" becomes akamai-bob.example.com.
# Keeps ephemeral guests namespaced away from real subdomains.
INSTANCE_PREFIX="akamai-"

# Labels that may never be provisioned (checked against the name alone, before
# the prefix is applied), in addition to anything that already exists in DNS.
# Usually empty once INSTANCE_PREFIX namespaces guests.
RESERVED_NAMES=""

###############################################################################
# Guest network (static IPs handed out from a pool)
###############################################################################

# Linux bridge on the hypervisor the guests attach to.
HOST_BRIDGE="br0"

# Pool of guest addresses: POOL_PREFIX.POOL_START .. POOL_PREFIX.POOL_END.
# Each live instance holds exactly one address; the pool size is therefore
# also the hard cap on concurrent instances.
POOL_PREFIX="10.0.0"
POOL_START="200"
POOL_END="219"
POOL_PREFIX_LEN="24"
POOL_GATEWAY="10.0.0.1"
POOL_DNS="10.0.0.1"

###############################################################################
# Guest sizing and lifecycle
###############################################################################

GUEST_MEMORY_MIB="1024"
GUEST_VCPUS="1"

# Seconds to wait for the guest to answer HTTP before provisioning is failed
# and rolled back.
GUEST_BOOT_TIMEOUT="300"

# Instances are torn down automatically once older than this (bin/reap.sh,
# run from a systemd timer). Hours; may be fractional.
INSTANCE_TTL_HOURS="2"

# Optional: SSH public key(s) installed for the "core" user in every guest,
# one per line. Leave empty to build guests with no SSH access at all.
GUEST_SSH_AUTHORIZED_KEYS=""

###############################################################################
# Host paths and commands
###############################################################################

# Unprivileged account the web service runs as (see deploy/OUTSIDE_THIS_REPO.md).
SERVICE_USER="akamai"

# Loopback port web/server.py binds to; nginx proxy_pass on PORTAL_HOST uses this.
WEB_LISTEN_PORT="8095"

# Directory nginx includes per-instance server blocks from. Must be somewhere
# the nginx process can read (for a containerised nginx: a bind-mounted path).
NGINX_INSTANCE_DIR="/etc/nginx/sites-available/akamai.d"

# Snippet that provides "listen 443 ssl;" and the wildcard certificate for
# BASE_DOMAIN, included by every generated server block.
NGINX_SSL_SNIPPET="/etc/nginx/snippets/wildcard_ssl.conf"

# How to validate and reload nginx on this host.
NGINX_TEST_CMD="docker exec nginx-waf nginx -t"
NGINX_RELOAD_CMD="systemctl reload nginx"

# libvirt connection used for all virsh calls.
LIBVIRT_URI="qemu:///system"

# Per-request limits enforced by the web service.
RATE_LIMIT_PER_IP_PER_HOUR="3"

# Optional: link to this project's source, shown in the form footer.
REPO_URL=""
