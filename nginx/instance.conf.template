# @@FQDN@@ -> http://@@IP@@/
# Generated by the akamai provisioner; removed again on teardown. Do not edit.

server {
  listen 80;
  server_name @@FQDN@@;
  return 301 https://@@FQDN@@$request_uri;
}

server {
  server_name @@FQDN@@;

  # "listen 443 ssl;" plus the zone's wildcard certificate.
  include @@SSL_SNIPPET@@;

  access_log /var/log/nginx/akamai-instances-access.log main;
  error_log  /var/log/nginx/akamai-instances-error.log;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;

  location / {
    proxy_pass http://@@IP@@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The guest is on the local bridge; fail fast rather than hang if it is
    # mid-boot or has already been reaped.
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    proxy_cache off;
  }
}
